<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet configuration for the AVA solution.

  The cds.codex feed is a private Azure DevOps package source required by the
  Ava.MetaQuery.* projects (CDS.Codex, Oracle EF, etc.). Credentials are NOT
  stored in this repo. Provide them locally via ONE of:

    1. A user-level nuget.config at %APPDATA%\NuGet\NuGet.Config containing a
       packageSourceCredentials entry for "cds.codex".
    2. The environment variable consumed by NuGet:
         NuGetPackageSourceCredentials_cds_x0020_codex = "Username=USER;Password=PAT"
       (NuGet encodes the space in the source key as _x0020_).
    3. Running "dotnet nuget add source" locally with your username/PAT; it
       writes credentials to your user config, never to this repository.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="cds.codex" value="https://cdsado.oneabbott.com/tfs/clinical_data_systems/_packaging/codex/nuget/v3/index.json" />
  </packageSources>
</configuration>
