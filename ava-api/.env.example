# Azure OpenAI
AVA__AzureOpenAi__Endpoint=https://<your-resource>.openai.azure.com/
AVA__AzureOpenAi__ApiKey=<your-api-key>
AVA__AzureOpenAi__ChatDeployment=gpt-4o
AVA__AzureOpenAi__EmbeddingDeployment=text-embedding-3-small

# ── Context Forge MCP gateway ─────────────────────────────────────────────────
# Set the BaseUrl to the full gateway URL (incl. ?server_id=...) and BearerToken
# to authenticate to the gateway. The per-user ADO PAT (entered in the UI) is
# forwarded to Azure DevOps automatically — no service PAT is stored here.
# Set ToolPrefix to the prefix Context Forge prepends to tool names (if any).
# Keep the token secret — use appsettings.Secrets.json on the server.
AVA__Services__context-forge__BaseUrl=https://cdsappsdev.oneabbott.com/contextforge/mcp/?server_id=<server-id>
AVA__Services__context-forge__BearerToken=<gateway-jwt>
AVA__Services__context-forge__ToolPrefix=

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5010
