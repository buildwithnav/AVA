<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <remove name="WebDAV" />
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <!--
        stdoutLogEnabled is false because the app pool identity may not have permission to create
        the logs sub-directory. Structured logs are written by FileLoggerProvider to
        logs\ava-api-{date}.log — that provider fails silently if the folder is unwritable.
        Enable stdoutLogEnabled temporarily only to diagnose very early startup crashes
        (before the .NET runtime initialises) after granting the app pool identity
        write access to the logs\ folder.
      -->
      <aspNetCore processPath="dotnet" arguments=".\Ava.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
